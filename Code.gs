/** Google Apps Script backend. Set Script Property SPREADSHEET_ID and optionally PUBLICATION_KEY. */
const SHEET_NAME = "RSVP";
const HEADERS = ["Waktu Pengiriman","Nama Tamu","Status Kehadiran","Jumlah Tamu","Ucapan dan Doa"];
function sheet_(){const id=PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");if(!id)throw new Error("SPREADSHEET_ID belum diatur");const ss=SpreadsheetApp.openById(id);let sh=ss.getSheetByName(SHEET_NAME);if(!sh){sh=ss.insertSheet(SHEET_NAME);sh.appendRow(HEADERS);sh.setFrozenRows(1);}return sh;}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
function clean_(v,max){return String(v==null?"":v).replace(/[\\u0000-\\u001f\\u007f]/g," ").trim().slice(0,max);}
function doGet(e){try{if((e.parameter||{}).action!=="messages")return json_({success:true,service:"RSVP"});const sh=sheet_();const rows=sh.getDataRange().getDisplayValues();const messages=[];for(let i=rows.length-1;i>=1&&messages.length<50;i--){const row=rows[i];const msg=clean_(row[4],500);if(msg&&row[2]==="Hadir"&&clean_(row[1],100))messages.push({name:clean_(row[1],100),message:msg});}return json_({success:true,messages:messages});}catch(err){return json_({success:false,error:"Ucapan belum tersedia"});}}
function doPost(e){let lock;try{const raw=(e.postData&&e.postData.contents)||"{}";if(raw.length>12000)return json_({success:false,error:"Data terlalu besar"});const data=JSON.parse(raw);const name=clean_(data.name,100);const attendance=clean_(data.attendance,20);const message=clean_(data.message,500);let guests=Number(data.guests);if(!name||!["Hadir","Tidak Hadir"].includes(attendance)||!Number.isInteger(guests))return json_({success:false,error:"Data tidak valid"});if(attendance==="Tidak Hadir")guests=0;else if(guests<1||guests>4)return json_({success:false,error:"Jumlah tamu harus 1 sampai 4"});if(/<|>|javascript:/i.test(message)||/</.test(name))return json_({success:false,error:"Karakter tidak diizinkan"});const key=PropertiesService.getScriptProperties().getProperty("PUBLICATION_KEY");if(key&&clean_(data.key,200)!==key)return json_({success:false,error:"Permintaan tidak diizinkan"});lock=LockService.getScriptLock();lock.waitLock(10000);sheet_().appendRow([new Date(),name,attendance,guests,message]);return json_({success:true});}catch(err){return json_({success:false,error:"Terjadi kesalahan saat menyimpan RSVP"});}finally{if(lock&&lock.hasLock())lock.releaseLock();}}
